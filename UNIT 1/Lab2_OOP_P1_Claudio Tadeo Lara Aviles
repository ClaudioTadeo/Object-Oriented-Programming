class User:
    def __init__(self, name, email):
        self.name = name
        self.email = email


class Post:
    def __init__(self, content, user):
        self.content = content
        self.user = user


class Comment:
    def __init__(self, content, user, post):
        self.content = content
        self.user = user
        self.post = post


class Message:
    def __init__(self, content, sender, receiver):
        self.content = content
        self.sender = sender
        self.receiver = receiver



miles = User("Miles", "miles@mail.com")
bignoob = User("BIGNOOB", "bignoob@mail.com")

post = Post("Hola a todos", miles)
comment = Comment("Hola, Miles", bignoob, post)
message = Message("¿Cómo estás?", miles, bignoob)

print(post.content)
print(comment.content) 
print(message.content)